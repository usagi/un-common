{
  "name": "un-i18n-svelte",
  "version": "0.1.0",
  "description": "Svelte / svelte-i18n side of the U.N. series i18n bridge. Pairs with the un-i18n Rust crate to bulk-load Tauri-bundled locale messages.",
  "license": "MIT",
  "author": "usagi / USAGI.NETWORK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usagi/un-common.git",
    "directory": "packages/un-i18n-svelte"
  },
  "keywords": [
    "i18n",
    "svelte",
    "svelte-i18n",
    "tauri",
    "localization"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2",
    "svelte-i18n": "^4"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "rimraf": "^6",
    "svelte-i18n": "^4",
    "typescript": "^5"
  }
}
